# -*- mode: python ; coding: utf-8 -*-
# PyInstaller spec for Kaira v1.2 — --onedir build
# Run: pyinstaller kaira.spec
# Output: dist/Kaira/Kaira.exe

import os
import sys
from PyInstaller.utils.hooks import (
    collect_all, collect_data_files, collect_dynamic_libs
)

block_cipher = None

# Collect silero-vad-lite data (ONNX model + native DLL)
silero_datas = collect_data_files('silero_vad_lite')

# Collect sounddevice's PortAudio binaries
sd_datas = collect_data_files('_sounddevice_data')

# ── faster-whisper local fallback (v1.2.0) ───────────────────────────
# ctranslate2 ships native Windows DLLs (ctranslate2.dll, openblas.dll,
# MKL DLLs on some wheels) INSIDE its Python package directory — and
# PyInstaller's standard analysis does not walk into them by default.
# collect_all() is the critical call. Without it, the bundled exe
# silently fails to import ctranslate2 with "DLL load failed" at first
# local fallback. Also collects faster_whisper + tokenizers metadata.
# Reference: research/Kaira v1.3 — faster-whisper Local Fallback
#   Implementation-Ready Research Brief.md §5
ct2_datas, ct2_binaries, ct2_hiddenimports = collect_all('ctranslate2')
fw_datas,  fw_binaries,  fw_hiddenimports  = collect_all('faster_whisper')
tok_datas, tok_binaries, tok_hiddenimports = collect_all('tokenizers')
hfh_datas, hfh_binaries, hfh_hiddenimports = collect_all('huggingface_hub')

a = Analysis(
    ['kaira.py'],
    pathex=[],
    binaries=ct2_binaries + fw_binaries + tok_binaries + hfh_binaries,
    datas=silero_datas + sd_datas
          + ct2_datas + fw_datas + tok_datas + hfh_datas + [
        # Ship kaira.ico alongside the exe so Qt's app.setWindowIcon() can
        # find it at runtime. PyInstaller's `icon=` only sets the exe's
        # resource metadata; Qt-owned dialogs need a file on disk.
        ('kaira.ico', '.'),
    ],
    hiddenimports=[
        # sounddevice needs cffi backend
        'sounddevice',
        '_sounddevice_data',
        'cffi',
        '_cffi_backend',
        # pynput keyboard controller (used for paste simulation)
        'pynput.keyboard._win32',
        'pynput._util.win32',
        # keyring Windows backend
        'keyring.backends.Windows',
        # openai + httpx transport
        'openai',
        'httpx',
        'httpcore',
        'h11',
        'anyio',
        'anyio._backends._asyncio',
        'sniffio',
        # tenacity for retry logic
        'tenacity',
        # silero-vad-lite
        'silero_vad_lite',
        # comtypes for UI Automation
        'comtypes',
        'comtypes.gen',
        # numpy
        'numpy',
        # faster-whisper local fallback submodules (collect_all catches most
        # but list the critical ones defensively)
        'ctranslate2',
        'ctranslate2.models',
        'faster_whisper',
        'faster_whisper.transcribe',
        'tokenizers',
        'huggingface_hub',
        'requests',
        'av',  # faster-whisper uses PyAV internally for non-WAV inputs
    ] + ct2_hiddenimports + fw_hiddenimports + tok_hiddenimports + hfh_hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        # Exclude heavy unused packages to reduce size. torch in particular
        # sneaks in via transformers if present — exclude explicitly to keep
        # the zip small and the CPU path clean.
        'tkinter',
        'matplotlib',
        'scipy',
        'pandas',
        'PIL',
        'cv2',
        'pytest',
        'IPython',
        'jupyter',
        'torch',
        'torchvision',
        'torchaudio',
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='Kaira',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,       # UPX compression triggers more Defender false positives
    console=False,       # No console window — Kaira is a GUI tray app
    icon='kaira.ico',    # Warm Ember waveform bars, generated by scripts/make_icon.py
)

coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=False,
    name='Kaira',
)
